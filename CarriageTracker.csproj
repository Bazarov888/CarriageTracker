<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>CarriageTracker</AssemblyName>
    <RootNamespace>CarriageTracker</RootNamespace>
    <!-- The only place the version and the plugin identity are written. MyPluginInfo (used by the code)
         and the Thunderstore manifest.json are generated from these at build time. -->
    <Version>1.0.21</Version>
    <PluginGuid>CarriageTracker</PluginGuid>
    <PluginName>CarriageTracker</PluginName>
    <Description>Carriages on the map for everyone, chat announcements when they set out, and automatic carriage starts in every act where players are online.</Description>
    <WebsiteUrl>https://github.com/Bazarov888/CarriageTracker</WebsiteUrl>
    <Authors>Bazarov</Authors>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NuGetAudit>false</NuGetAudit>
    <RestoreSources>https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json</RestoreSources>
  </PropertyGroup>

  <!-- tests/ is a separate program (tests of Logic/), not part of the mod. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

  <!-- Default build: game, BepInEx and VCF reference assemblies come from NuGet, so the mod builds anywhere:
         dotnet build -c Release -->
  <ItemGroup Condition="'$(BepDir)' == ''">
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.733" PrivateAssets="all" />
    <PackageReference Include="VampireReferenceAssemblies" Version="1.1.12-r99041-b2" PrivateAssets="all" />
    <PackageReference Include="VRising.VampireCommandFramework" Version="0.10.4" PrivateAssets="all" />
  </ItemGroup>

  <!-- Alternative: build against the BepInEx folder of an installed server, no NuGet needed:
         dotnet build -c Release -p:BepDir=/path/to/server/BepInEx -->
  <ItemGroup Condition="'$(BepDir)' != ''">
    <Reference Include="$(BepDir)/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepDir)/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepDir)/core/BepInEx.Unity.Common.dll" Private="false" Condition="Exists('$(BepDir)/core/BepInEx.Unity.Common.dll')" />
    <Reference Include="$(BepDir)/core/0Harmony.dll" Private="false" />
    <Reference Include="$(BepDir)/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepDir)/core/Il2CppInterop.Common.dll" Private="false" Condition="Exists('$(BepDir)/core/Il2CppInterop.Common.dll')" />
    <Reference Include="$(BepDir)/interop/*.dll" Private="false" />
    <Reference Include="$(BepDir)/plugins/**/VampireCommandFramework.dll" Private="false" />
  </ItemGroup>

  <!-- MyPluginInfo.PLUGIN_GUID / PLUGIN_NAME / PLUGIN_VERSION for the code, generated into obj/.
       Inside the text %3B is ";" and &quot; is a double quote: MSBuild would otherwise split the text at ";". -->
  <Target Name="GenerateMyPluginInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <MyPluginInfoFile>$(IntermediateOutputPath)MyPluginInfo.g.cs</MyPluginInfoFile>
      <MyPluginInfoText>// Generated from CarriageTracker.csproj at build time. Change the version there.
namespace CarriageTracker
{
    public static class MyPluginInfo
    {
        public const string PLUGIN_GUID = &quot;$(PluginGuid)&quot;%3B
        public const string PLUGIN_NAME = &quot;$(PluginName)&quot;%3B
        public const string PLUGIN_VERSION = &quot;$(Version)&quot;%3B
    }
}</MyPluginInfoText>
    </PropertyGroup>
    <WriteLinesToFile File="$(MyPluginInfoFile)" Lines="$(MyPluginInfoText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(MyPluginInfoFile)" />
      <FileWrites Include="$(MyPluginInfoFile)" />
    </ItemGroup>
  </Target>

  <!-- Release build also makes the Thunderstore package: dist/CarriageTracker-<version>.zip,
       with manifest.json generated from the properties above. -->
  <Target Name="ThunderstorePackage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PkgDir>$(MSBuildProjectDirectory)/dist/pkg</PkgDir>
      <ManifestText>{
  &quot;name&quot;: &quot;$(PluginName)&quot;,
  &quot;version_number&quot;: &quot;$(Version)&quot;,
  &quot;website_url&quot;: &quot;$(WebsiteUrl)&quot;,
  &quot;description&quot;: &quot;$(Description)&quot;,
  &quot;dependencies&quot;: [
    &quot;BepInEx-BepInExPack_V_Rising-1.733.2&quot;,
    &quot;deca-VampireCommandFramework-0.10.4&quot;
  ]
}</ManifestText>
    </PropertyGroup>
    <RemoveDir Directories="$(PkgDir)" />
    <Copy SourceFiles="README.md;CHANGELOG.md;icon.png;LICENSE;$(TargetPath)" DestinationFolder="$(PkgDir)" />
    <WriteLinesToFile File="$(PkgDir)/manifest.json" Lines="$(ManifestText)" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(PkgDir)" DestinationFile="$(MSBuildProjectDirectory)/dist/CarriageTracker-$(Version).zip" Overwrite="true" />
    <RemoveDir Directories="$(PkgDir)" />
  </Target>

</Project>
